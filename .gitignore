# Generated by Cargo
/target/
**/target/

# Cargo.lock is excluded for libraries (included for binaries)
# This is a library, so we exclude it
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.vim/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Project-specific
codegen.log
.prism.log
Brewfile.lock.json

# Test and coverage
*.profraw
*.profdata
coverage/
tarpaulin-report.html
cobertura.xml

# Documentation build
/doc/

# Benchmark artifacts
criterion/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local
